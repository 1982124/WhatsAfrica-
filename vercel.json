{
  "rewrites": [
    { "source": "/", "destination": "/app-v2.html" },
    { "source": "/:slug", "destination": "/public.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(self), payment=()" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://dzifpwqrqnvssfhwjccj.supabase.co https://openrouter.ai; font-src 'self' data: https:; media-src 'self' data: blob: https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https:;" }
      ]
    },
    {
      "source": "/app-v2.html",
      "headers": [
        { "key": "X-WhatsAfrica-Version", "value": "public-v3-smartlink-final" },
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/public.html",
      "headers": [
        { "key": "X-WhatsAfrica-Version", "value": "public-v3-smartlink-final" },
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    }
  ]
}
