{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [{"path":"/api/demand-report","schedule":"0 10 * * *"}],
  "redirects": [
    {"source":"/inbox","destination":"/inbox-v25.html","permanent":false},
    {"source":"/messages","destination":"/inbox-v25.html","permanent":false},
    {"source":"/calls","destination":"/inbox-v25.html","permanent":false},
    {"source":"/call","destination":"/inbox-v25.html","permanent":false},
    {"source":"/appels","destination":"/inbox-v25.html","permanent":false}
  ],
  "rewrites": [
    {"source":"/","destination":"/launch-shell.html"},
    {"source":"/auth","destination":"/auth-v8.html"},
    {"source":"/profile","destination":"/profile.html"},
    {"source":"/install","destination":"/install.html"},
    {"source":"/manifesto","destination":"/manifesto.html"},
    {"source":"/dashboard","destination":"/dashboard-v3.html"},
    {"source":"/cockpit","destination":"/admin-cockpit-v3.html"},
    {"source":"/admin-commercial-controls","destination":"/admin-commercial-controls.html"},
    {"source":"/smartlink","destination":"/smartlink-free-v3.html"},
    {"source":"/smartlink-ai","destination":"/smartlink-ai-v2.html"},
    {"source":"/smartlink-pro","destination":"/smartlink-business.html"},
    {"source":"/smartlink-theme","destination":"/smartlink-theme-v2.html"},
    {"source":"/vitrine","destination":"/business-vitrine-v3.html"},
    {"source":"/wassafrica","destination":"/wassafrica-official.html"},
    {"source":"/demo","destination":"/demo-business.html"},
    {"source":"/presentation","destination":"/presentation.html"},
    {"source":"/partenaires","destination":"/enterprise-partners-v2.html"},
    {"source":"/enterprise","destination":"/enterprise-partners-v2.html"},
    {"source":"/offer-create","destination":"/offer-create-free-v3.html"},
    {"source":"/digital-products","destination":"/offer-create-free-v3.html?type=digital"},
    {"source":"/services","destination":"/offer-create-free-v3.html?type=service"},
    {"source":"/digital-market","destination":"/market-v4.html"},
    {"source":"/message-invite","destination":"/message-invite.html"},
    {"source":"/groups","destination":"/groups-v5.html"},
    {"source":"/groups/:id","destination":"/community-v7.html"},
    {"source":"/groups/:id/admin","destination":"/group-admin-v1.html"},
    {"source":"/universe","destination":"/universe-fast-v4.html"},
    {"source":"/market","destination":"/market-shell.html"},
    {"source":"/commerce","destination":"/market-v4.html"},
    {"source":"/product","destination":"/market-v4.html"},
    {"source":"/product/:id","destination":"/product.html?id=:id"},
    {"source":"/service/:id","destination":"/service-detail-v1.html?id=:id"},
    {"source":"/contact-seller","destination":"/seller-contact-v1.html"},
    {"source":"/market-pricing","destination":"/market-pricing.html"},
    {"source":"/payments","destination":"/financial-services-v2.html"},
    {"source":"/finance","destination":"/financial-services-v2.html"},
    {"source":"/forgot-password","destination":"/forgot-password.html"},
    {"source":"/reset-password","destination":"/reset-password.html"},
    {"source":"/confirm-email","destination":"/confirm-email.html"},
    {"source":"/account-security","destination":"/account-security.html"},
    {"source":"/admin","destination":"/admin-cockpit-v3.html"},
    {"source":"/design-settings","destination":"/design-settings.html"},
    {"source":"/analytics","destination":"/analytics-shell.html"},
    {"source":"/assistant","destination":"/assistant-settings.html"},
    {"source":"/assistant-settings","destination":"/assistant-settings.html"},
    {"source":"/broadcast-admin","destination":"/broadcast-admin.html"},
    {"source":"/payment-links","destination":"/payment-links.html"},
    {"source":"/group-manager","destination":"/group-manager.html"},
    {"source":"/invite","destination":"/invite.html"},
    {"source":"/share","destination":"/share-center.html"},
    {"source":"/crm","destination":"/crm.html"},
    {"source":"/live","destination":"/live-v3.html"},
    {"source":"/live/:id","destination":"/live.html"},
    {"source":"/business-live","destination":"/live-v3.html"},
    {"source":"/business-live/:id","destination":"/live.html"},
    {"source":"/meeting","destination":"/meeting.html"},
    {"source":"/commande/:token","destination":"/order-tracking.html"},
    {"source":"/s/:token","destination":"/share.html"},
    {"source":"/network","destination":"/africa-network.html"},
    {"source":"/discover","destination":"/discover-v1.html"},
    {"source":"/privacy","destination":"/privacy.html"},
    {"source":"/terms","destination":"/terms.html"},
    {"source":"/seller-rules","destination":"/seller-rules.html"},
    {"source":"/llm.txt","destination":"/llm.txt"},
    {"source":"/:slug","destination":"/smartlink-public-v7.html"}
  ],
  "headers": [
    {"source":"/(.*)","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
      {"key":"Permissions-Policy","value":"camera=(self), geolocation=(), microphone=(self), payment=(self)"},
      {"key":"X-Frame-Options","value":"DENY"},
      {"key":"Strict-Transport-Security","value":"max-age=63072000; includeSubDomains; preload"},
      {"key":"X-WASSAFRICA-Release","value":"2026-09-17-omni-cto"}
    ]},
    {"source":"/(api|dashboard|cockpit|admin-commercial-controls|design-settings|smartlink|smartlink-ai|smartlink-pro|smartlink-theme|offer-create|admin|crm|calls|call|appels|inbox|messages|share|analytics|assistant-settings|broadcast-admin|payment-links|payments|finance|group-manager|group-admin|vitrine|digital-products|digital-market|services|auth|forgot-password|reset-password|confirm-email|account-security|install|manifesto|message-invite)(.*)","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"}]},
    {"source":"/profile","headers":[{"key":"X-Robots-Tag","value":"noindex, no-store, max-age=0"}]},
    {"source":"/(api|commande|s)(.*)","headers":[{"key":"Cache-Control","value":"private, no-store, max-age=0"}]},
    {"source":"/(dashboard|cockpit|admin-commercial-controls|design-settings|smartlink|smartlink-ai|smartlink-pro|smartlink-theme|offer-create|admin|crm|calls|call|appels|inbox|messages|share|analytics|assistant-settings|broadcast-admin|payment-links|payments|finance|group-manager|group-admin|vitrine|digital-products|digital-market|services|market-pricing|auth|forgot-password|reset-password|confirm-email|account-security|install|manifesto|message-invite)(.*)","headers":[{"key":"Cache-Control","value":"private, no-store, max-age=0"}]}
  ]
}
