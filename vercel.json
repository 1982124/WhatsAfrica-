{
  "rewrites": [
    { "source": "/", "destination": "/launch.html" },
    { "source": "/auth", "destination": "/auth.html" },
    { "source": "/reset-password", "destination": "/reset-password.html" },
    { "source": "/confirm-email", "destination": "/confirm-email.html" },
    { "source": "/admin", "destination": "/admin-cockpit.html" },
    { "source": "/dashboard", "destination": "/cockpit.html" },
    { "source": "/smartlink", "destination": "/cockpit.html" },
    { "source": "/vitrine", "destination": "/business-vitrine.html" },
    { "source": "/analytics", "destination": "/analytics.html" },
    { "source": "/assistant", "destination": "/assistant-settings.html" },
    { "source": "/assistant-settings", "destination": "/assistant-settings.html" },
    { "source": "/broadcast-admin", "destination": "/broadcast-admin.html" },
    { "source": "/payment-links", "destination": "/payment-links.html" },
    { "source": "/group-manager", "destination": "/group-manager.html" },
    { "source": "/invite", "destination": "/invite.html" },
    { "source": "/inbox", "destination": "/inbox.html" },
    { "source": "/share", "destination": "/share-center.html" },
    { "source": "/calls", "destination": "/calls-v2.html" },
    { "source": "/crm", "destination": "/crm.html" },
    { "source": "/live", "destination": "/live.html" },
    { "source": "/live/:id", "destination": "/live.html" },
    { "source": "/business-live", "destination": "/live.html" },
    { "source": "/business-live/:id", "destination": "/live.html" },
    { "source": "/groups", "destination": "/groups.html" },
    { "source": "/universe", "destination": "/universe.html" },
    { "source": "/commande/:token", "destination": "/order-tracking.html" },
    { "source": "/s/:token", "destination": "/share.html" },
    { "source": "/:slug", "destination": "/smart-commerce-v2.html" }
  ],
  "headers": [
    {"source":"/(.*)","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
      {"key":"Permissions-Policy","value":"camera=(self), geolocation=(), microphone=(self), payment=()"},
      {"key":"X-Frame-Options","value":"DENY"},
      {"key":"Strict-Transport-Security","value":"max-age=63072000; includeSubDomains; preload"},
      {"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}
    ]},
    {"source":"/(api|dashboard|smartlink|admin|crm|calls|inbox|share|analytics|assistant-settings|broadcast-admin|payment-links|group-manager|vitrine|auth|reset-password|confirm-email)(.*)","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"}]}
  ]
}
