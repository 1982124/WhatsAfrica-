{
  "rewrites": [
    { "source": "/", "destination": "/launch.html" },
    { "source": "/:slug", "destination": "/public.html" }
  ],
  "headers": [
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"Permissions-Policy","value":"camera=(), geolocation=(), microphone=(self), payment=()"},{"key":"X-Frame-Options","value":"DENY"},{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"}]}
  ]
}