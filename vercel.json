{
  "rewrites": [
    { "source": "/", "destination": "/app-v5.html" },
    { "source": "/:slug", "destination": "/app-v5.html" }
  ],
  "headers": [
    {
      "source": "/app-v5.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    }
  ]
}
